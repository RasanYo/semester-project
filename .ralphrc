# .ralphrc - Ralph project configuration
# Generated by: ralph enable
# Documentation: https://github.com/frankbria/ralph-claude-code

# Project identification
PROJECT_NAME="semester-project"
PROJECT_TYPE="python"

# Claude Code CLI command
# If "claude" is not in your PATH, set to your installation:
#   "npx @anthropic-ai/claude-code"  (uses npx, no global install needed)
#   "/path/to/claude"                (custom path)
# claude-ralph = claude --permission-mode bypassPermissions (wrapper dans ~/.local/bin).
# Nécessaire : en headless, claude refuse toute écriture sous .claude/ (agents, skills)
# quels que soient ALLOWED_TOOLS — voir l'en-tête du wrapper.
CLAUDE_CODE_CMD="claude-ralph"

# Loop settings
MAX_CALLS_PER_HOUR=100
# 30 : une boucle qui installe des dépendances ou fait tourner une suite
# complète ne tient pas en 15 min. L'état est idempotent, un timeout ne coûte
# qu'une reprise.
CLAUDE_TIMEOUT_MINUTES=30
CLAUDE_OUTPUT_FORMAT="json"
# Token limit per hour (0 = disabled). One invocation can use 100k+ tokens.
# Recommended: 500000 for light use, 2000000 for heavy use.
#MAX_TOKENS_PER_HOUR=0

# Tool permissions
# Comma-separated list of allowed tools
# Safe git subcommands only - broad Bash(git *) allows destructive commands like git clean/git rm (Issue #149)
ALLOWED_TOOLS="Write,Read,Edit,Bash(git add *),Bash(git commit *),Bash(git diff *),Bash(git log *),Bash(git status),Bash(git status *),Bash(git push *),Bash(git pull *),Bash(git fetch *),Bash(git checkout *),Bash(git branch *),Bash(git stash *),Bash(git merge *),Bash(git tag *),Bash(git show *),Bash(git worktree *),Bash(git rev-parse *),Bash(git -C *),Bash(pytest),Bash(pytest *),Bash(python *),Bash(python3 *),Bash(uv *),Bash(ruff *),Bash(.venv/bin/python *),Bash(.venv/bin/pip *),Bash(.venv/bin/ruff *),Bash(.venv/bin/pytest *),Bash(npm *),Bash(cat *),Bash(ls *),Bash(grep *),Bash(rg *),Bash(find *),Bash(head *),Bash(tail *),Bash(wc *),Bash(sed *),Bash(diff *),Bash(jq *),Bash(echo *),Bash(touch *),Bash(mkdir *),Bash(mv *),Bash(cp *),Bash(rm *),Bash(sha256sum *),Bash(PYTHONPATH=*)"

# Session management
SESSION_CONTINUITY=true
SESSION_EXPIRY_HOURS=24

# Task sources (for ralph enable --sync)
# Options: local, beads, github (comma-separated for multiple)
# local : pas encore de tracker GitHub sur ce repo. Repasser à "github,local"
# le jour où les issues portent le travail.
TASK_SOURCES="local"
GITHUB_TASK_LABEL="ralph-task"
BEADS_FILTER="status:open"

# Circuit breaker thresholds
CB_NO_PROGRESS_THRESHOLD=3
CB_SAME_ERROR_THRESHOLD=5
CB_OUTPUT_DECLINE_THRESHOLD=70

# Auto-update Claude CLI at startup
CLAUDE_AUTO_UPDATE=true

# Shell init file (optional)
# Source this file before running claude — useful when claude requires environment
# variables or PATH entries defined in a non-bash shell config (e.g. ~/.zshrc).
# Leave commented out unless needed.
#RALPH_SHELL_INIT_FILE="~/.zshrc"
